<body>
	<p> Welcome to wss </p>
	<div class="log-container">
        <!-- Toolbar Header -->
        <div class="log-header">
            <div class="log-title">System Live Logs</div>
            <div class="controls">
                <select id="levelFilter" class="filter-select" onchange="filterLogs()">
                    <option value="all">All Levels</option>
                    <option value="info">Info</option>
