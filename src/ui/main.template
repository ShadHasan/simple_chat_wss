	<script>
		/* There is two websocket communication. 
		1. using websocket direct for signaling.
		2. using via ICE client for actual communication between clients

		Now, signaling websocket can be used
		1. registering candidate
		2. fetching altname
		3. request altname to be my network.
		4. accept altname to my altname network.   // 3,4 steps allow to directly allow to fetch candidate when altname is available online.
		5. get candidate of altname from my network // After this ICE client add this candidate
		6. sending offer as altname to other altname 
		7. receiving offer from other altname to my altname 
		8. receiver will create answer
		9. sender altname will receive answer  // At this point ICE Client peer connection ready for communication.

		Now, ICE Client
		ICE Client have its datachannel and it is client for remotechannel
		if it has initiated communication mean created then ice client it will use datachannel
		else it will use remotechannel.

		*/
		class MainUI {
		
			constructor() {
				this.debug_panel = document.getElementBy("debug_panel");
				this.logger = Logger("logViewer", "levelFilter");
			}
			
			testLog() {
				// Seed initial display entries
				this.logger.appendLog("System initializing execution tree...", "info");
				this.logger.appendLog("Debug flags verified actively listening.", "debug");
				this.logger.appendLog("Cron worker pool reporting standard operational thresholds.", "info");
			}
			
			
		}
		
		class ChatRoom {
		
		}
		
		class PeerConnection {
			states = {
				"initial": ["closed", "candiate_gathered"],
				"candiate_gathered": ["candidate_registered", "closed"],
				"candidate_registered": ["offer_forwarded"],
				"peerAdded": ["answer_forwarded"],
				"offer_forwarded": ["answer_received"],
				"answer_received": ["channel_established"],
				"offer_received": ["peerAdded"],
				"answer_forwarded": ["channel_established"],
				"channel_established": ["bye"]
				"bye": ["closed"]
				"closed": null
			}
			
			// expected_state = states[current_states];
		
			async constructor(mainUI, altname, offerType, label) {
				this.current_states = "initial"
				this.mainUI = mainUI;
				this.altname = altname;
				this.signalServer = signalServer;
				this.candidate = null;
				this.label = crypto.randomUUID();
				this.pc = new RTCPeerConnection({
					iceServers: [
					{
						// Correct scheme 'stun:' and precise subdomain + port
						urls: [
						'stun:stun.l.google.com:19302',
						'stun:stun1.l.google.com:19302',
						'stun:stun2.l.google.com:19302'
						]
					}]
				});
				
				// --- 1. CHANNEL MANAGEMENT: Handle Local Data/Media ---
				// Create a data channel (required to trigger ICE gathering if you don't use video/audio)
				this.dataChannel = this.pc.createDataChannel("chat");
				this.dataChannel.onmessage = (e) => console.log("Received peer message:", e.data);
				
				// Listen for incoming data channels from the other peer
				this.pc.ondatachannel = (event) => {
					this.remoteChannel = event.channel;
					this.remoteChannel.onmessage = (e) => console.log("Received peer message:", e.data);
				};
				
				// 2. Generate the local SDP description object
				this.offer = await pc.createOffer();
				
				// 3. Save it locally (This starts internal ICE gathering)
				this.pc.setLocalDescription(offer);
				
				// --- 2. ICE GATHERING ---
				this.pc.onicecandidate = (event) => {
					if (event.candidate) {
						this.candidate = event.candidate;
					}
				};
				
				// --- 3. CONNECTION CLOSE Log ---
				pc.onconnectionstatechange = () => {
				  switch (pc.connectionState) {
					case "disconnected":
					case "failed":
					  console.log("Network dropped. Triggering automatic cleanup.");
					  terminatePeerConnection(pc, activeChannels, localStream);
					  break;
					case "closed":
					  console.log("Connection securely finalized.");
					  break;
				  }
				};
				
			}
			
			send(message) {
			}
			
			close() {
				if (!this.pc) return;

			  // 1. Unsubscribe from all event listeners to prevent memory leaks
			  this.pc.onicecandidate = null;
			  this.pc.onicegatheringstatechange = null;
			  this.pc.onconnectionstatechange = null;
			  this.pc.onsignalingstatechange = null;
			  this.pc.oniceconnectionstatechange = null;
			  this.pc.ontrack = null;
			  this.pc.ondatachannel = null;
			  
			  dataChannels = [this.dataChannel, this.remoteChannel];
			  // 2. Close all active Data Channels
			  dataChannels.forEach(channel => {
				if (channel && channel.readyState !== "closed") {
				  channel.onmessage = null;
				  channel.onopen = null;
				  channel.onclose = null;
				  channel.onerror = null;
				  channel.close();
				}
			  });
			  
			  // 3. Close the Peer Connection
			  this.pc.close();
			  
			  // 4. Garbage collection cleanup
			  this.pc = null;
			  console.log("WebRTC Peer Connection fully destroyed.");
			}
			
			
			
		}
	 
		class SignalManager {
			static const signal_directive = ['register_candidates', 'forward_offer', 'forward_answer', 
				'my_websocket_requested_altnames', 'forward_network_request', 
				'forward_network_request_response', 'public_altname', 'request_candidate', 
				'update_my_altname_access'];
		
			constructor(mainUI) {
				this.signalingSocket = new WebSocket('wss://wss.tinyorb.org:10008/ws/signal');
				this.mainUI = mainUI;
				this.peerConnections = {}
				this.signalingSocket.onmessage = (response) => {
					response.signal_response : {'registered_candidate': [ok, nok], 'altname_candidates': [], 'forwarded_offer': [ok, nok], 'fowarded_answer':[ok, nok]}
					
					switch(response.signal_response) {
						case "registered_candidate":
							break;
						case "altname_candidates":
							break;
						case "forwarded_offer":
							break;
						case "fowarded_answer":
							break;
						case "fowarded_answer":
							break;
						case "my_candidate_shared_to_altnames":
							break;
						case "access_updated":
							break
						case "fowarded_network_request":
							break;
						case "forward_network_request_response":
							break;
						case "public_altnames":
							this.mainUI.logger.appendLog("Signal respon with public altnames", "info");
							this.loadPublicAltname(response.public_altnames);
							break;
						default:
							this.mainUI.logger.appendLog("Unknown signal response", "error");
							break;
						
					}
					
				};
			 
			}
			
			getAllPeerConnections() {
				return this.peerConnections;
			}
			
			createNewPeerConnection(uniquePCName, altname, offerType) {
				let pc = new PeerConnection(this.mainUI, altname, offerType);
				this.peerConnections[uniquePCName] = {
					"pc": pc
				};
			}
			
			loadPublicAltname(altnames) {
				this.mainUI.load_public_altnames(altnames);
			}
			
			checkAndRegisterCandidate(uniquePCName, access=null) {
				this.mainUI.appendLogToDebug("Checking and registering candidate");
				if(accept == null)
					access = "private";
				
				if (this.peerConnections[uniquePCName].candidate != null && this.signalingSocket.readyState === WebSocket.OPEN) {
					// 
					this.send(JSON.stringify({
						directive: signal_directive[0],
						"altname": this.peerConnections[uniquePCName].altname,
						"client_type": "end",
						"access": access,
						"candidate": this.peerConnections[uniquePCName].candidate
					}));
					this.mainUI.appendLogToDebug("Checking and registering candidate");
				} else {
					this.mainUI.appendLogToDebug("Either candidate or websocket is not ready");
				}
				
			}
			
			send(data) {
				signalingSocket.send(data);
			}
		
		}
	
	
	</script>

</body>
</html>