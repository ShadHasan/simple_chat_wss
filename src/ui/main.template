	<script>
		/* There is two websocket communication. 
		1. using websocket direct for signaling.
		2. using via ICE client for actual communication between clients

		Now, signaling websocket can be used
		1. registering candidate
		2. fetching altname
		3. request altname to be my network.
		4. accept altname to my altname network.   // 3,4 steps allow to directly allow to fetch candidate when altname is available online.
		5. get candidate of altname from my network // After this ICE client add this candidate
		6. sending offer as altname to other altname 
		7. receiving offer from other altname to my altname 
		8. receiver will create answer
		9. sender altname will receive answer  // At this point ICE Client peer connection ready for communication.

		Now, ICE Client
		ICE Client have its datachannel and it is client for remotechannel
		if it has initiated communication mean created then ice client it will use datachannel
		else it will use remotechannel.

		*/
		
		// Define the sleep function
		const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
		
		// Usage:
		// await sleep(2000);
		
		class MainUI {
		
			constructor() {
				
				// Core layout toggles
				const sidePanel = document.getElementById('sidePanel');
				const minimizeBtn = document.getElementById('minimizeBtn');
				const restoreBtn = document.getElementById('restoreBtn');
				this.xlogger = null;

				minimizeBtn.addEventListener('click', () => {
					sidePanel.classList.add('minimized');
					restoreBtn.classList.add('visible');
				});

				restoreBtn.addEventListener('click', () => {
					sidePanel.classList.remove('minimized');
					restoreBtn.classList.remove('visible');
				});
				
				
			}
			
			async asyncInit() {
				console.log("Async initializing is going own");
				
				let logger = null;
				
				while (logger==null) {
					try {
					
						// Note: await sleep hold this function for prvided interval time which is 1 sec ie 1000 ms
						await sleep(1000);
						logger = new Logger("logViewer", "levelFilter");
					}
					catch {
						// do nothing
					}
				}
				
				this.xlogger = logger;
				
				
			}
			
			appendLog(msg, severity="info") {
				if (this.xlogger != null)
					this.xlogger.appendLog(msg, severity);
				else {
						console.log("logger is not loaded yet");
						console.log("your log: ", msg, severity);
					}
			}
			
			/**
			 * Appends an HTML string as a distinct single line entry inside a designated panel.
			 * @param {string} panelId - The HTML id of the panel target container (e.g., 'panel-1a')
			 * @param {string} htmlString - The string representing the HTML to insert
			 */
			appendPanelEntry(panelId, htmlString) {
				const container = document.getElementById(panelId);
				if (!container) {
					console.error(`Panel container with id "${panelId}" not found.`);
					return;
				}

				// Create a wrapper row to encapsulate the item cleanly as a single entry block
				const wrapper = document.createElement('div');
				wrapper.className = 'line-entry';
				wrapper.innerHTML = htmlString;

				container.appendChild(wrapper);
				
				// Auto scroll container down to show the latest entry
				container.scrollTop = container.scrollHeight;
			}
			
			toggelSwitchFactory(parentContainerEle, switchId, statusTextId, checkedText, uncheckedText, checkedCallback, uncheckedCallback) {
				let toggleHTML = `<div class="toggle-container">
				  <!-- Accessible switch label setup -->
				  <label class="switch">
					<input type="checkbox" id="${switchId}">
					<span class="slider"></span>
				  </label>
				  <!-- Label reflecting the real-time state change -->
				  <span id="${statusTextId}">${uncheckedText}</span>
				</div>
				`;
				
				let styles = document.createElement('style');
				styles.textContent = `
				  /* Status text display styling */
				  #${switchId} {
					font-size: 1.2rem;
					font-weight: bold;
					color: #333;
					min-width: 40px;
				  }
				`;
				parentContainerEle.innerHTML += toggleHTML;
				document.head.appendChild(styles);
				
				// Grab DOM elements
			  let toggleSwitchEle = document.getElementById(switchId);
			  let statusTextEle = document.getElementById(statusTextId);

			  // Add event listener to listen for changes
			  toggleSwitchEle.addEventListener('change', function() {
				if (this.checked) {
				  statusTextEle.textContent = checkedText;
				  // Add additional logic here for when the switch turns ON
				  // console.log("Switch is active.");
				  
				  if(checkedCallback != null) {
					checkedCallback();
				  }
				  
				} else {
				  statusTextEle.textContent = uncheckedText;
				  // Add additional logic here for when the switch turns OFF
				  // console.log("Switch is inactive.");
				  if (uncheckedCallback != null) {
					uncheckedCallback();
				  }
				}
			  });
			  
				
			}
			
			chatWindowFactory(chatRoomId, dataChannel) {
				// 1. Create container window element
				const chatWindow = document.createElement('div');
				chatWindow.id = chatRoomId;
				
				// 2. Inject advanced layout rules via CSS
				const styles = document.createElement('style');
				styles.textContent = `
					#${chatRoomId} {
						position: fixed;
						bottom: 20px;
						right: 20px;
						width: 320px;
						height: 400px; /* Set baseline height for vertical sizing */
						min-width: 260px;
						min-height: 200px;
						max-width: 600px;
						max-height: 800px;
						background: #ffffff;
						border: 1px solid #e2e8f0;
						border-radius: 12px;
						box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
						font-family: system-ui, -apple-system, sans-serif;
						z-index: 99999;
						display: flex;
						flex-direction: column;
						overflow: hidden;
						resize: both; /* Enforces native container resizing */
					}
					.chat-win-header {
						background: #1a202c;
						color: #ffffff;
						padding: 10px 14px;
						display: flex;
						justify-content: space-between;
						align-items: center;
						font-size: 14px;
						font-weight: 600;
						cursor: move;
						user-select: none;
						flex-shrink: 0;
					}
					.chat-win-close {
						background: none;
						border: none;
