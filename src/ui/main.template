			}
			
			
			// Signal function related
			checkAndRegisterCandidate(uniquePCName, access=null) {
				this.mainUI.appendLog("Checking and registering candidate", "info");
				if(accept == null)
					access = "private";
				
				if (this.peerConnections[uniquePCName].candidate != null && this.signalingSocket.readyState === WebSocket.OPEN) {
					// 
					this.send(JSON.stringify({
						pc_uuid: uniquePCName,
						directive: this.signal_directive[0],
						client_type: "end",
						candidate: this.peerConnections[uniquePCName].candidate
					}));
					this.mainUI.appendLog("Send candidate registeration", "info");
				} else {
					this.mainUI.appendLog("Either candidate or websocket is not ready", "error");
				}
				
			}
			
			// This will trigger manually. Hence it is not part of automation.
			sendOffer(uniquePCName, toAltname) {
				this.mainUI.appendLog("Sending offer", "info");
				this.peerConnections[uniquePCName].ldpOfferSetPromise.then(() => {
					this.send(JSON.stringify({
						offer_pc_uuid: uniquePCName,
						answer_pc_uuid: null,
						directive: this.signal_directive[1],
						to_altname: toAltname,
						sdp: this.peerConnections[uniquePCName].localDescription
					}));
					this.mainUI.appendLog("Offer sent", "info");
				});
				
			}
			
			// This will trigger manually. Hence it is not part of automation.
			sendAnswer(uniquePCName, toAltname, offerAccepted) {
				// Here answer can be done to reject offer for different reason.
				this.mainUI.appendLog(`Sending answer for offer with ${offerAccepted}`, "info");
				if (offerAccepted) {
					this.peerConnections[uniquePCName].ldpAnswerSetPromise.then(()=>{
						this.send(JSON.stringify({
							answer_pc_uuid: uniquePCName,
							offer_pc_uuid: this.peerConnections[uniquePCName]["offer_pc_uuid"],
							directive: this.signal_directive[2],
							to_altname: toAltname,
							sdp: this.peerConnections[uniquePCName].localDescription,
							offer_accepted: offerAccepted
						}));
						this.mainUI.appendLog("Answer sent", "info");
					});
				} else {
					this.send(JSON.stringify({
						pc_uuid: uniquePCName,
						directive: this.signal_directive[2],
						to_altname: toAltname,
						sdp: null,
						offer_accepted: offerAccepted
					}));
					this.mainUI.appendLog("Answer sent", "info");
				}
			}
			
			// This will trigger manually. Hence it is not part of automation.
			requestNetwork(uniquePCName, toAltname) {
				this.mainUI.appendLog("Sending network request", "info");
				this.send(JSON.stringify({
					pc_uuid: uniquePCName,
					directive: this.signal_directive[3],
					to_altname: toAltname
				}));
			}
			
			// This will trigger manually. Hence it is not part of automation.
			sendNetworkResponse(uniquePCName, toAltname, networkRequest) {
				this.mainUI.appendLog("Sending network request response", "info");
				if (this.#possible_network_request.includes(networkRequest)) {
					this.send(JSON.stringify({
						pc_uuid: uniquePCName,
						directive: this.signal_directive[4],
						to_altname: toAltname,
						network_request: networkRequest
					}));
				} else {
					this.mainUI.appendLog("Network request can be either accepted and rejected", "error");
				}
			}
			
			
			// This will trigger manually. Hence it is not part of automation.
			updateMyAltnameAccess(uniquePCName, access) {
				this.mainUI.appendLog("Sending access update", "info");
				this.send(JSON.stringify({
					directive: this.signal_directive[7],
					access: access
				}));
			}
			
			// This will trigger manually. Hence it is not part of automation.
			getPublicAltname() {
				this.mainUI.appendLog("Fetching all public altname", "info");
				this.send(JSON.stringify({
					directive: this.signal_directive[5]
				}));
			}
			
			// Generic websocket send.
			send(data) {
				this.signalingSocket.send(data);
			}
			
		
		}
	
