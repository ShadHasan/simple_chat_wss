					}
					.bubble-outgoing {
						background: #3182ce;
						color: #ffffff;
						align-self: flex-end;
						border-bottom-right-radius: 2px;
					}
					.bubble-incoming {
						background: #e2e8f0;
						color: #2d3748;
						align-self: flex-start;
						border-bottom-left-radius: 2px;
					}

					.chat-win-footer {
						padding: 12px;
						display: flex;
						gap: 8px;
						background: #ffffff;
						border-top: 1px solid #edf2f7;
						flex-shrink: 0;
					}
					.chat-win-input {
						flex: 1;
						padding: 8px 12px;
						border: 1px solid #cbd5e0;
						border-radius: 6px;
						font-size: 14px;
						outline: none;
					}
					.chat-win-input:focus {
						border-color: #3182ce;
					}
					.chat-win-send {
						background: #3182ce;
						color: white;
						border: none;
						padding: 8px 14px;
						border-radius: 6px;
						cursor: pointer;
						font-size: 14px;
