		class PeerConnection {
			states = {
				"initial": ["closed", "candiate_gathered"],
				"candiate_gathered": ["candidate_registered", "closed"],
				"candidate_registered": ["offer_forwarded"],
				"peerAdded": ["answer_forwarded"],
				"offer_forwarded": ["answer_received"],
				"answer_received": ["channel_established"],
				"offer_received": ["peerAdded"],
				"answer_forwarded": ["channel_established"],
				"channel_established": ["bye"],
				"bye": ["closed"],
				"closed": null
			};
			
			// expected_state = states[current_state];
		
			constructor(mainUI, altname, offerType, label) {
				this.current_state = "initial";
				this.mainUI = mainUI;
				this.altname = altname;
				this.signalServer = signalServer;
				this.candidate = null;
				this.offer = null;
				this.label = crypto.randomUUID();
				this.pc = new RTCPeerConnection({
					iceServers: [
					{
						// Correct scheme 'stun:' and precise subdomain + port
						urls: [
						'stun:stun.l.google.com:19302',
						'stun:stun1.l.google.com:19302',
						'stun:stun2.l.google.com:19302'
						]
					}]
				});
				
				// --- 1. CHANNEL MANAGEMENT: Handle Local Data/Media ---
				// Create a data channel (required to trigger ICE gathering if you don't use video/audio)
				this.dataChannel = this.pc.createDataChannel("chat");
				this.dataChannel.onmessage = (e) => {
					console.log("Received peer message:", e.data);
				}
				
				// Listen for incoming data channels from the other peer
				this.pc.ondatachannel = (event) => {
					this.remoteChannel = event.channel;
					this.remoteChannel.onmessage = (e) => {
						console.log("Received peer message:", e.data);
					}
				};
				
				
				
				this.ldpOfferSetPromise = new Promise((resolve) => {
					// Generate the local SDP description object with offer
					// Save it locally (This starts internal ICE gathering)
					offer = this.pc.createOffer();
					this.pc.setLocalDescription(offer);
					resolve();
				});
				
				this.ldpOfferSetPromise.then(() => {
					this.mainUI.appendLog("LDP set with offer is ready", "info");
				});
				
				// --- 2. ICE GATHERING ---
				this.pc.onicecandidate = (event) => {
					if (event.candidate) {
						this.candidate = event.candidate;
						this.current_state = "candiate_gathered";
					}
				};
				
				// --- 3. CONNECTION CLOSE Log ---
				pc.onconnectionstatechange = () => {
				  switch (pc.connectionState) {
					case "disconnected":
					case "failed":
					  this.mainUI.appendLog("Network dropped. Triggering automatic cleanup.", "error");
					  this.close();
					  break;
					case "closed":
					  this.mainUI.appendLog("WebRTC Peer Connection fully destroyed.", "info");
					  break;
				  }
				};
				
			}
			
			createAnwerPromise(remoteSessionDescriptionProtocol) {
				this.mainUI.appendLog("Creating promise for LDP set with answer", "info");
				this.ldpAnswerSetPromise = new Promise((resolve) => {
					// Generate the local SDP description object with answer
					this.pc.setRemoteDescription(new RTCSessionDescription(remoteSessionDescriptionProtocol));
					answer = this.pc.createAnswer();
					this.pc.setLocalDescription(answer);
					resolve(True);
				});
				this.ldpAnswerSetPromise.then(() => {
					this.mainUI.appendLog("LDP set with answer is ready", "info");
				});
				this.mainUI.appendLog("Promise for LDP set with answer created", "info");
			}
			
			updateOfferLDP_RDP(remoteSessionDescriptionProtocol) {
				this.mainUI.appendLog("Updating Offer LDP set with rdp", "info");
				this.ldpOfferSetPromise.then(() => {
					this.pc.setRemoteDescription(new RTCSessionDescription(remoteSessionDescriptionProtocol));
					this.mainUI.appendLog("Updated Offer LDP set with rdp", "info");
				});
			
			}
			
			addPeerCandidate() {
			}
			
			send(message) {
				if (this.current_state == "channel_established") {
					// use datachannel to send message
					this.mainUI.chatWindowFactory(this.label, );
				} else {
					this.mainUI.appendLog("Data channel is not ready", "error");
				}
			}
			
			close() {
				if (!this.pc) return;

			  // 1. Unsubscribe from all event listeners to prevent memory leaks
			  this.pc.onicecandidate = null;
			  this.pc.onicegatheringstatechange = null;
			  this.pc.onconnectionstatechange = null;
			  this.pc.onsignalingstatechange = null;
			  this.pc.oniceconnectionstatechange = null;
			  this.pc.ontrack = null;
			  this.pc.ondatachannel = null;
			  
			  dataChannels = [this.dataChannel, this.remoteChannel];
			  // 2. Close all active Data Channels
			  dataChannels.forEach(channel => {
				if (channel && channel.readyState !== "closed") {
				  channel.onmessage = null;
				  channel.onopen = null;
				  channel.onclose = null;
				  channel.onerror = null;
				  channel.close();
				}
			  });
			  
			  // 3. Close the Peer Connection
			  this.pc.close();
			  
			  // 4. Garbage collection cleanup
			  this.pc = null;
			  this.mainUI.appendLog("WebRTC Peer Connection fully destroyed.", "info");
			}
			
			changeState(newState) {
				if (this.states[this.current_state].includes(newState)) {
					this.current_state = newState;
				} else {
					this.mainUI.appendLog(`Unexpected new state: ${newState} from state: ${this.current_state}`, "error");
				}
			}
			
		}
		
		
	 
		class SignalManager {
		
			signal_directive = ['register_candidates', 'forward_offer', 'forward_answer',
				'forward_network_request', 
				'forward_network_request_response', 'public_altname', 'request_candidate', 
				'update_my_altname_access', 'pc_init_uuid'];
				
			#possible_network_request = ["accepted", "rejected"];
		
			constructor(mainUI) {
				this.signalingSocket = new WebSocket('wss://wss.tinyorb.org:10008/ws/signal');
				this.mainUI = mainUI;
				this.peerConnections = {};
				
				this.signalUiHandles = {
					btnHandleDisconnectSignalServer: {handle: null, id: "disconnect-signal-server-btn"},
					btnHandleLoadPublicAltname: {handle: null, id: "load-public-altname-btn"},
					btnHandleGoPublic: {handle: null, id: "load-public-altname-btn"},
					panelOfferIncoming: {handle: null, id: "offer-incoming-panel"},
					panelPublicAltnames: {handle: null, id: "public-altnames-panel"},
					panelNetworkAltnames: {handle: null, id: "network-altnames-panel"},
					panelChatWindow: {handle: null, id: "chat-window-panel"}
				};
				
				this.signalingSocket.addEventListener('open', (event) => {
					this.mainUI.appendLog("Signal socket is ready", "info");
				});
				
				 // Listener for If there's an error with the WebSocket connection
                this.signalingSocket.addEventListener('error', (error) => {
					this.mainUI.appendLog(`WebSocket Error:, ${error}`, "error");

                });
				
				// Listener for If the connection is closed
                this.signalingSocket.addEventListener('close', () => {
					this.mainUI.appendLog("WebSocket connection closed", "info");
                });
				
				this.signalingSocket.onmessage = (event) => {
					//this.mainUI.appendLog(`Response: ${response}, ${typeof response}`, "debug");
					// below one line is rough, Todo remove
					// response.signal_response : {'registered_candidate': [ok, nok], 'altname_candidates': [], 'forwarded_offer': [ok, nok], 'fowarded_answer':[ok, nok]}
					let response = JSON.parse(event.data);
					switch(response.signal_response) {
						case "registered_candidate":
							if (response.status == "ok") {
								this.peerConnections[response.pc_uuid].pc.changeState("candidate_registered");
								this.mainUI.appendLog("candidate registered successfully", "info");
							} else {
								this.mainUI.appendLog("candidate registeration failed", "error");
							}
							break;
						case "forwarded_offer":
							if (response.status == "ok") {
								this.mainUI.appendLog("Forwared offer successfully", "info");
							} else {
								this.mainUI.appendLog("Offer forward fail", "error");
							}
							break;
						case "fowarded_answer":
							if (response.status == "ok") {
								this.mainUI.appendLog("Forwared answer successfully", "info");
							} else {
								this.mainUI.appendLog("Answer forward fail", "error");
							}
							break;
						case "incoming_offer":
							this.mainUI.appendLog("Incoming offer", "info");
							this.peerConnections[response.answer_pc_uuid]["offer_pc_uuid"] = response.offer_pc_uuid;
							this.peerConnections[response.answer_pc_uuid]["remote_pc_uuid"] = response.offer_pc_uuid;
							this.peerConnections[response.answer_pc_uuid]["party"] = "answering";
							this.peerConnections[response.answer_pc_uuid].pc.createAnwerPromise(response.sdp);
							break;
						case "incoming_answer":
							this.mainUI.appendLog("Incoming answer", "info");
							if (this.peerConnections[response.offer_pc_uuid]["remote_pc_uuid"] == null) {
								this.peerConnections[response.offer_pc_uuid]["answer_pc_uuid"] = response.answer_pc_uuid;
								this.peerConnections[response.offer_pc_uuid]["remote_pc_uuid"] = response.answer_pc_uuid;
								this.peerConnections[response.answer_pc_uuid]["party"] = "offering";
								this.peerConnections[response.offer_pc_uuid].pc.updateOfferLDP_RDP(response.sdp);
							} else {
								this.mainUI.appendLog("Ignoring others incoming answer", "warn");
							}
							break;
						case "altname_candidates":
							loadPublicAltname(response.candidates);
							break;
						case "access_updated":
							this.mainUI.appendLog("Access updated", "info");
							this.loadAccessUpdate();
							break
						case "fowarded_network_request":
							if (response.status == "ok") {
								this.mainUI.appendLog("Ack forwarded network request", "info");
							} else {
								this.mainUI.appendLog("Ack forwarded network request failed", "error");
							}
							break;
						case "forward_network_request_response":
							if (response.status == "ok") {
								this.mainUI.appendLog("Ack forwarded network request response", "info");
							} else {
								this.mainUI.appendLog("Ack forwarded network request response failed", "error");
							}
							break;
						case "incoming_network_request":
							this.loadNetworkRequest(data);
							break;
						case "incoming_network_request_response":
							this.updateMyNetwork();
							break;
						case "public_altnames":
							this.mainUI.appendLog("Signal respon with public altnames", "info");
							this.loadPublicAltname(response.public_altnames);
							break;
						case "networks_altnames":
							this.loadMyAltnameNetworks(response.networks_altnames);
							break;
						case "pc_initiated_uuid":
							this.createNewPeerConnection("initiated", data.pc_uuid, data.altname, data.offerType);
							break;
						default:
							console.log(response);
							this.mainUI.appendLog(`Error: ${response.Error}`, "error");
							this.mainUI.appendLog("Unknown signal response", "error");
							break;
					}
					
				};
			 
			}
			
			async asyncInit() {
				
				for (let handle in this.signalUiHandles ) {
					while (this.signalUiHandles[handle].handle == null) {
						
						this.signalUiHandles[handle].handle = document.getElementById(this.signalUiHandles[handle].id);
						if (this.signalUiHandles[handle].handle == null) {
							this.mainUI.appendLog(`Handle is not loaded for id: ${this.signalUiHandles[handle].id}`, "warn");
							await sleep(500);
						}
						else {
							this.mainUI.appendLog(`Handle is loaded for id: ${this.signalUiHandles[handle].id}`, "info");
						}
					}
				}
				
				this.signalUiHandles.btnHandleLoadPublicAltname.handle.addEventListener("click", (event) => {
					this.getPublicAltname();
				});
				
				
			}
			
			createNewPeerConnection(phase, uniquePCName, altname, offerType) {
				switch(phase) {
				    // case init will triggered manually with uniquePCName null
					case "init":
						this.mainUI.appendLog("Initializing peer connection", "info");
						this.send(JSON.stringify({
							directive: this.signal_directive[8],
							altname: altname,
							offerType: offerType
						}));
						break;
					// case initiated will be automatically after signal response.
					case "initiated":
						let pc = new PeerConnection(this.mainUI, altname, offerType);
						this.peerConnections[uniquePCName] = {
							pc: pc
						};
						this.mainUI.appendLog("Peer connection initialized", "info");
						break;
				}
				
			}
			
			
			loadPublicAltname(altnames) {
				for(let i =0; i<altnames.length; i++) {
					this.mainUI.appendPanelEntry(
						this.signalUiHandles.panelPublicAltnames.id, 
						`<div>${altnames[i]}</div>`
					);
				}
			}
			
