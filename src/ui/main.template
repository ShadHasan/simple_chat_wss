					}
					.chat-win-send:hover {
						background: #2b6cb0;
					}
				`;
				document.head.appendChild(styles);

				// 3. Assemble structural components safely using DOM methods
				const header = document.createElement('div');
				header.className = 'chat-win-header';
				
				const title = document.createElement('span');
				title.textContent = 'Chat Room';
				
				const closeBtn = document.createElement('button');
				closeBtn.className = 'chat-win-close';
				closeBtn.textContent = '×';
				
				header.appendChild(title);
				header.appendChild(closeBtn);

				// Dynamic History Field
				const historyContainer = document.createElement('div');
				historyContainer.className = 'chat-win-history';

				const footer = document.createElement('div');
				footer.className = 'chat-win-footer';

				const input = document.createElement('input');
				input.type = 'text';
				input.className = 'chat-win-input';
				input.placeholder = 'Type your message...';

				const sendBtn = document.createElement('button');
				sendBtn.className = 'chat-win-send';
				sendBtn.textContent = 'Send';

				footer.appendChild(input);
				footer.appendChild(sendBtn);

				chatWindow.appendChild(header);
				chatWindow.appendChild(historyContainer);
				chatWindow.appendChild(footer);
				document.body.appendChild(chatWindow);

				// 4. Drag and Drop Engine
				let isDragging = false;
				let startX = 0, startY = 0;

				header.addEventListener('mousedown', dragStart);

				function dragStart(e) {
					if (e.target === closeBtn) return;
					isDragging = true;
					
					const rect = chatWindow.getBoundingClientRect();
					startX = e.clientX - rect.left;
					startY = e.clientY - rect.top;

					// Strip static viewport alignments cleanly to enforce direct pixel mapping
					chatWindow.style.bottom = 'auto';
					chatWindow.style.right = 'auto';
					chatWindow.style.left = `${rect.left}px`;
					chatWindow.style.top = `${rect.top}px`;

					document.addEventListener('mousemove', dragMove);
					document.addEventListener('mouseup', dragEnd);
				}

				function dragMove(e) {
					if (!isDragging) return;

					let newX = e.clientX - startX;
					let newY = e.clientY - startY;

					const maxW = window.innerWidth - chatWindow.offsetWidth;
					const maxH = window.innerHeight - chatWindow.offsetHeight;
					
					newX = Math.max(0, Math.min(newX, maxW));
					newY = Math.max(0, Math.min(newY, maxH));

					chatWindow.style.left = `${newX}px`;
					chatWindow.style.top = `${newY}px`;
				}

				function dragEnd() {
					isDragging = false;
					document.removeEventListener('mousemove', dragMove);
					document.removeEventListener('mouseup', dragEnd);
				}

				// 5. Chat History & Submission Pipeline
				function appendMessage(text, direction) {
					const bubble = document.createElement('div');
					bubble.className = `chat-bubble bubble-${direction}`;
					bubble.textContent = text;
					
					historyContainer.appendChild(bubble);
					
					// Snap visibility downward to capture latest bubble
					historyContainer.scrollTop = historyContainer.scrollHeight;
				}

				function handleSubmission() {
					const text = input.value.trim();
					if (!text) return;

					// Render outgoing text message
					appendMessage(text, 'outgoing');
					input.value = '';

					// Simulate an automated incoming server response reply
					setTimeout(() => {
						appendMessage(`Received payload: "${text}"`, 'incoming');
					}, 800);
				}

				// Bind event interactive links
				closeBtn.onclick = () => chatWindow.remove();
				sendBtn.onclick = handleSubmission;
				input.onkeydown = (e) => { if (e.key === 'Enter') handleSubmission(); };

				
				return appendMessage;
			}
			
