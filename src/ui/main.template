		class PeerConnection {
			states = {
				"initial": ["closed", "candiate_gathered"],
				"candiate_gathered": ["candidate_registered", "closed"],
				"candidate_registered": ["offer_forwarded"],
				"peerAdded": ["answer_forwarded"],
				"offer_forwarded": ["answer_received"],
				"answer_received": ["channel_established"],
				"offer_received": ["peerAdded"],
				"answer_forwarded": ["channel_established"],
				"channel_established": ["bye"]
				"bye": ["closed"]
				"closed": null
			};
			
			// expected_state = states[current_state];
		
			async constructor(mainUI, altname, offerType, label) {
				this.current_state = "initial";
				this.mainUI = mainUI;
				this.altname = altname;
				this.signalServer = signalServer;
				this.candidate = null;
				this.offer = null;
				this.label = crypto.randomUUID();
				this.pc = new RTCPeerConnection({
					iceServers: [
					{
						// Correct scheme 'stun:' and precise subdomain + port
						urls: [
						'stun:stun.l.google.com:19302',
						'stun:stun1.l.google.com:19302',
						'stun:stun2.l.google.com:19302'
						]
					}]
				});
				
				// --- 1. CHANNEL MANAGEMENT: Handle Local Data/Media ---
				// Create a data channel (required to trigger ICE gathering if you don't use video/audio)
				this.dataChannel = this.pc.createDataChannel("chat");
				this.dataChannel.onmessage = (e) => {
					console.log("Received peer message:", e.data);
				}
				
				// Listen for incoming data channels from the other peer
				this.pc.ondatachannel = (event) => {
					this.remoteChannel = event.channel;
					this.remoteChannel.onmessage = (e) => {
						console.log("Received peer message:", e.data);
					}
				};
				
				
				
				this.ldpOfferSetPromise = new Promise((resolve) => {
					// Generate the local SDP description object with offer
					// Save it locally (This starts internal ICE gathering)
					offer = this.pc.createOffer();
					this.pc.setLocalDescription(offer);
					resolve();
				});
				
				this.ldpOfferSetPromise.then(() => {
					this.mainUI.logger.appendLog("LDP set with offer is ready", "info");
				});
				
				// --- 2. ICE GATHERING ---
				this.pc.onicecandidate = (event) => {
					if (event.candidate) {
						this.candidate = event.candidate;
						this.current_state = "candiate_gathered";
					}
				};
				
				// --- 3. CONNECTION CLOSE Log ---
				pc.onconnectionstatechange = () => {
				  switch (pc.connectionState) {
					case "disconnected":
					case "failed":
					  this.mainUI.logger.appendLog("Network dropped. Triggering automatic cleanup.", "error");
					  this.close();
					  break;
					case "closed":
					  this.mainUI.logger.appendLog("WebRTC Peer Connection fully destroyed.", "info");
					  break;
				  }
				};
				
			}
			
			createAnwerPromise(remoteSessionDescriptionProtocol) {
				this.mainUI.logger.appendLog("Creating promise for LDP set with answer", "info");
				this.ldpAnswerSetPromise = new Promise((resolve) => {
					// Generate the local SDP description object with answer
					this.pc.setRemoteDescription(new RTCSessionDescription(remoteSessionDescriptionProtocol));
					answer = this.pc.createAnswer();
					this.pc.setLocalDescription(answer);
					resolve(True);
				});
				this.ldpAnswerSetPromise.then(() => {
					this.mainUI.logger.appendLog("LDP set with answer is ready", "info");
				});
				this.mainUI.logger.appendLog("Promise for LDP set with answer created", "info");
			}
			
			updateOfferLDP_RDP(remoteSessionDescriptionProtocol) {
				this.mainUI.logger.appendLog("Updating Offer LDP set with rdp", "info");
				this.ldpOfferSetPromise.then(() => {
					await this.pc.setRemoteDescription(new RTCSessionDescription(remoteSessionDescriptionProtocol));
					this.mainUI.logger.appendLog("Updated Offer LDP set with rdp", "info");
				});
			
			}
			
			
			send(message) {
				if (this.current_state == "channel_established") {
					// use datachannel to send message
					this.mainUI.chatWindowFactory(this.label, );
				} else {
					this.mainUI.logger.appendLog("Data channel is not ready", "error");
				}
			}
			
			close() {
				if (!this.pc) return;

			  // 1. Unsubscribe from all event listeners to prevent memory leaks
			  this.pc.onicecandidate = null;
			  this.pc.onicegatheringstatechange = null;
			  this.pc.onconnectionstatechange = null;
			  this.pc.onsignalingstatechange = null;
			  this.pc.oniceconnectionstatechange = null;
			  this.pc.ontrack = null;
			  this.pc.ondatachannel = null;
			  
			  dataChannels = [this.dataChannel, this.remoteChannel];
			  // 2. Close all active Data Channels
			  dataChannels.forEach(channel => {
				if (channel && channel.readyState !== "closed") {
				  channel.onmessage = null;
				  channel.onopen = null;
				  channel.onclose = null;
				  channel.onerror = null;
				  channel.close();
				}
			  });
			  
			  // 3. Close the Peer Connection
			  this.pc.close();
			  
			  // 4. Garbage collection cleanup
			  this.pc = null;
			  this.mainUI.logger.appendLog("WebRTC Peer Connection fully destroyed.", "info");
			}
			
			changeState(newState) {
				if (this.states[this.current_state].includes(newState)) {
					this.current_state = newState;
				} else {
					this.mainUI.logger.appendLog(`Unexpected new state: ${newState} from state: ${this.current_state}`, "error");
				}
			}
			
		}
	 
		class SignalManager {
			#signal_directive = ['register_candidates', 'forward_offer', 'forward_answer', 
				'my_websocket_requested_altnames', 'forward_network_request', 
				'forward_network_request_response', 'public_altname', 'request_candidate', 
				'update_my_altname_access'];
				
			#possible_network_request = ["accepted", "rejected"];
		
			constructor(mainUI) {
				this.signalingSocket = new WebSocket('wss://wss.tinyorb.org:10008/ws/signal');
				this.mainUI = mainUI;
				this.peerConnections = {}
				this.loadGenericInterface();
				this.signalingSocket.onmessage = (response) => {
					
					// below one line is rough, Todo remove
					// response.signal_response : {'registered_candidate': [ok, nok], 'altname_candidates': [], 'forwarded_offer': [ok, nok], 'fowarded_answer':[ok, nok]}
					
					switch(response.signal_response) {
						case "registered_candidate":
							if (response.status == "ok") {
								this.peerConnections[response.pc_uuid].changeState("candidate_registered");
								this.mainUI.logger.appendLog("candidate registered successfully", "info");
							} else {
								this.mainUI.logger.appendLog("candidate registeration failed", "error");
							}
							break;
						case "forwarded_offer":
							if (response.status == "ok") {
								this.mainUI.logger.appendLog("Forwared offer successfully", "info");
							} else {
								this.mainUI.logger.appendLog("Offer forward fail", "error");
							}
							break;
						case "fowarded_answer":
							if (response.status == "ok") {
								this.mainUI.logger.appendLog("Forwared answer successfully", "info");
							} else {
								this.mainUI.logger.appendLog("Answer forward fail", "error");
							}
							break;
						case "incoming_offer":
							this.mainUI.logger.appendLog("Incoming offer", "info");
							this.peerConnections[response.pc_uuid].createAnwerPromise(response.sdp);
							break;
						case "incoming_answer":
							this.mainUI.logger.appendLog("Incoming answer", "info");
							this.peerConnections[response.pc_uuid].updateOfferLDP_RDP(response.sdp);
							break;
						case "altname_candidates":
							loadPublicAltname(response.candidates);
							break;
						case "my_candidate_shared_to_altnames":
							break;
						case "access_updated":
							this.mainUI.logger.appendLog("Access updated", "info");
							loadAccessUpdate();
							break
						case "fowarded_network_request":
							if (response.status == "ok") {
								this.mainUI.logger.appendLog("Ack forwarded network request", "info");
							} else {
								this.mainUI.logger.appendLog("Ack forwarded network request failed", "error");
							}
							break;
						case "forward_network_request_response":
							if (response.status == "ok") {
								this.mainUI.logger.appendLog("Ack forwarded network request response", "info");
							} else {
								this.mainUI.logger.appendLog("Ack forwarded network request response failed", "error");
							}
							break;
						case "incoming_network_request":
							loadNetworkRequest(data);
							break;
						case "incoming_network_request_response":
							updateMyNetwork();
							break;
						case "public_altnames":
							this.mainUI.logger.appendLog("Signal respon with public altnames", "info");
							this.loadPublicAltname(response.public_altnames);
							break;
						case "networks_altnames":
							this.loadMyAltnameNetworks(response.networks_altnames);
							break;
						default:
							this.mainUI.logger.appendLog("Unknown signal response", "error");
							break;
						
					}
					
				};
			 
			}
			
			getAllPeerConnections() {
				return this.peerConnections;
			}
			
			createNewPeerConnection(uniquePCName, altname, offerType) {
				let pc = new PeerConnection(this.mainUI, altname, offerType);
				this.peerConnections[uniquePCName] = {
					"pc": pc
				};
			}
			
			// Related to loading interface
			loadGenericInterface() {
				this.mainUI.main();
			}
			
			loadPublicAltname(altnames) {
				this.mainUI.load_public_altnames(altnames);
			}
			
			loadIncomingOffer() {
			}
			
			loadChatWindowLineEntry() {
			}
			
			loadNetworkRequest() {
				
			}
			
			loadMyAltnameNetworks() {
			}
			
			loadAccessUpdate() {
			
			}
			
			
			// Signal function related
			checkAndRegisterCandidate(uniquePCName, access=null) {
				this.mainUI.logger.appendLog("Checking and registering candidate", "info");
				if(accept == null)
					access = "private";
				
				if (this.peerConnections[uniquePCName].candidate != null && this.signalingSocket.readyState === WebSocket.OPEN) {
					// 
					this.send(JSON.stringify({
						pc_uuid: uniquePCName,
						directive: signal_directive[0],
						altname: this.peerConnections[uniquePCName].altname,
						client_type: "end",
						access: access,
						candidate: this.peerConnections[uniquePCName].candidate
					}));
					this.mainUI.logger.appendLog("Send candidate registeration", "info");
				} else {
					this.mainUI.logger.appendLog("Either candidate or websocket is not ready", "error");
				}
				
			}
			
			// This will trigger manually. Hence it is not part of automation.
			sendOffer(uniquePCName, toAltname) {
				this.mainUI.logger.appendLog("Sending offer", "info");
				this.peerConnections[uniquePCName].ldpOfferSetPromise.then(() => {
					this.send(JSON.stringify({
						pc_uuid: uniquePCName,
						directive: signal_directive[1],
						from_altname: this.peerConnections[uniquePCName].altname,
						to_altname: toAltname,
						sdp: this.peerConnections[uniquePCName].localDescription
					}));
					this.mainUI.logger.appendLog("Offer sent", "info");
				});
				
			}
			
			// This will trigger manually. Hence it is not part of automation.
			sendAnswer(uniquePCName, toAltname, offerAccepted) {
				// Here answer can be done to reject offer for different reason.
				this.mainUI.logger.appendLog(`Sending answer for offer with ${offerAccepted}`, "info");
				if (offerAccepted) {
					this.peerConnections[uniquePCName].ldpAnswerSetPromise.then(()=>{
						this.send(JSON.stringify({
							pc_uuid: uniquePCName,
							directive: signal_directive[2],
							from_altname: this.peerConnections[uniquePCName].altname,
							to_altname: toAltname,
							sdp: this.peerConnections[uniquePCName].localDescription,
							offer_accepted: offerAccepted
						}));
						this.mainUI.logger.appendLog("Answer sent", "info");
					});
				} else {
					this.send(JSON.stringify({
						pc_uuid: uniquePCName,
						directive: signal_directive[2],
						from_altname: this.peerConnections[uniquePCName].altname,
						to_altname: toAltname,
						sdp: null,
						offer_accepted: offerAccepted
					}));
					this.mainUI.logger.appendLog("Answer sent", "info");
				}
			}
			
			// This will trigger manually. Hence it is not part of automation.
			requestNetwork(fromAltname, toAltname) {
				this.mainUI.logger.appendLog("Sending network request", "info");
				this.send(JSON.stringify({
					directive: signal_directive[4],
					from_altname: fromAltname,
					to_altname: toAltname
				}));
			}
			
			// This will trigger manually. Hence it is not part of automation.
			sendNetworkResponse(fromAltname, toAltname, networkRequest) {
				this.mainUI.logger.appendLog("Sending network request response", "info");
				if (this.#possible_network_request.includes(networkRequest)) {
					this.send(JSON.stringify({
						directive: signal_directive[5],
						from_altname: fromAltname,
						to_altname: toAltname,
						network_request: networkRequest
					}));
				} else {
					this.mainUI.logger.appendLog("Network request can be either accepted and rejected", "error");
				}
			}
			
			
			// This will trigger manually. Hence it is not part of automation.
			updateMyAltnameAccess(myAltname, access) {
				this.mainUI.logger.appendLog("Sending access update", "info");
				this.send(JSON.stringify({
					directive: signal_directive[8],
					altname: myAltname,
					access: access
				}));
			}
			
			// This will trigger manually. Hence it is not part of automation.
			getPublicAltname() {
				
			}
			
			// Generic websocket send.
			send(data) {
				signalingSocket.send(data);
			}
			
		
		}
	
	
