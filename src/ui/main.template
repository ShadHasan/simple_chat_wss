<!DOCTYPE html>
<html>
<head>
	<title> Main </title>
</head>
<body>
 <p> Welcome to wss </p>
 <div id="debug_panel">
 <div>
 
 <script>
 /* There is two websocket communication. 
 1. using websocket direct for signaling.
 2. using via ICE client for actual communication between clients
 
 Now, signaling websocket can be used
 1. registering candidate
 2. fetching altname
 3. request altname to be my network.
 4. accept altname to my altname network.   // 3,4 steps allow to directly allow to fetch candidat when altname is available online.
 5. get candidate of altname from my network // After this ICE client add this candidate
 6. sending offer as altname to other altname 
 7. receiving offer from other altname to my altname 
 8. receiver will create answer
 9. sender altname will receive answer  // At this point ICE Client peer connection ready for communication.
 
 Now, ICE Client
 ICE Client have its datachannel and it is client for remotechannel
 if it has initiated communication mean created then ice client it will use datachannel
 else it will use remotechannel.
 
 */
	class MainUI {
	
		constructor() {
			this.debug_panel = document.getElementBy("debug_panel");
		}
		
		appendLogToDebug(log) {
			this.debug_panel
		}
		
		
	}
 
	class SignalServer {
	
		constructor(mainUI) {
		 this.signalingSocket = new WebSocket('wss://wss.tinyorb.org:10008/ws/signal');
		 this.mainui = mainUI;
		 
		 this.signalingSocket.onmessage = (message) => {
			
		 };
		 
		}
		
		loadPublicAltname() {
			this.mainui.load_altname;
		}
		
		send(json_data) {
			signalingSocket.send(json_data);
		}
	
	}
	
	class PeerConnection {
		constructor(signalServer, mainUI) {
			this.signalServer = signalServer;
			this.mainUI = mainUI;
			this.pc = new RTCPeerConnection({
				iceServers: [
				{
					// Correct scheme 'stun:' and precise subdomain + port
					urls: [
					'stun:stun.l.google.com:19302',
					'stun:stun1.l.google.com:19302',
					'stun:stun2.l.google.com:19302'
					]
				}]
			});
			// --- 1. CHANNEL MANAGEMENT: Handle Local Data/Media ---
			// Create a data channel (required to trigger ICE gathering if you don't use video/audio)
			this.dataChannel = this.pc.createDataChannel("chat");
			this.dataChannel.onmessage = (e) => console.log("Received peer message:", e.data);
			
			// Listen for incoming data channels from the other peer
			pc.ondatachannel = (event) => {
				this.remoteChannel = event.channel;
				remoteChannel.onmessage = (e) => console.log("Received peer message:", e.data);
			};
			
			// --- 2. ICE GATHERING ---
			pc.onicecandidate = (event) => {
				if (event.candidate && signalingSocket.readyState === WebSocket.OPEN) {
					signalingSocket.send(JSON.stringify({
					type: 'ice-candidate',
					candidate: event.candidate
					}));
				}
			};
			
		}
		
		send(message) {
		}
		
		
		
	}
	
	class ChatRoom {
	
	}
	
	
	
 </script>
</body>
</html>