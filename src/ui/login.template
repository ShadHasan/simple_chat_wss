<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Google OAuth Login</title>
  <!-- Load the Google Identity Services SDK -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
      background-color: #f4f6f8;
    }
    .card {
      background: white;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      text-align: center;
    }
    #user-info {
      margin-top: 1.5rem;
      display: none;
    }
    .profile-img {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      margin-top: 10px;
    }
  </style>
</head>
<body>

  <div class="card">
    <h2>Welcome</h2>
    <p>Sign in using your Google account</p>

    <!-- Google Sign-In Button Container -->
    <div id="g_id_onload"
         data-client_id="223025000144-h24fpvolha8m78bl0askl3sal4agvbt2.apps.googleusercontent.com"
         data-callback="handleCredentialResponse"
         data-auto_prompt="false">
    </div>

    <div class="g_id_signin"
         data-type="standard"
         data-size="large"
         data-theme="outline"
         data-text="sign_in_with"
         data-shape="rectangular"
         data-logo_alignment="left">
    </div>

    <!-- Container to display user info after login -->
    <div id="user-info">
      <img id="profile-pic" class="profile-img" src="" alt="Profile Picture">
      <h3 id="user-name"></h3>
      <p id="user-email"></p>
    </div>
  </div>

  <script>
    // Callback function executed after successful Google authentication
    function handleCredentialResponse(response) {
      // response.credential contains the Encoded JWT ID Token
      const responsePayload = decodeJwtResponse(response.credential);

      console.log("ID Token:", response.credential);
      console.log("User Data:", responsePayload);

      // Render user profile details on the page
      document.getElementById('user-name').innerText = responsePayload.name;
      document.getElementById('user-email').innerText = responsePayload.email;
      document.getElementById('profile-pic').src = responsePayload.picture;
      document.getElementById('user-info').style.display = 'block';

      // NOTE: Send response.credential (the ID token) to your backend server via POST/fetch
      // for secure validation before logging the user into your application backend.
	  verifyTokenOnBackend(response);
    }

    // Helper function to parse JWT ID Token payload
    function decodeJwtResponse(token) {
      const base64Url = token.split('.')[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join(''));

      return JSON.parse(jsonPayload);
    }
	
	async function verifyTokenOnBackend(response) {
	  // Post the JWT token directly to your backend
	  try {
		const res = await fetch('https://wss.tinyorb.org:10008/api/auth/google', {
		  method: 'POST',
		  headers: {
			'Content-Type': 'application/json',
		  },
		  body: JSON.stringify({ token: response.credential }),
		});

		const data = await res.json();
		
		if (res.ok) {
		  console.log('Successfully logged in on backend:', data);
		  // Save session/JWT token from backend and redirect user
		} else {
		  console.error('Login failed:', data.error);
		}
	  } catch (error) {
		console.error('Error connecting to auth server:', error);
	  }
	}
	
  </script>
</body>
</html>